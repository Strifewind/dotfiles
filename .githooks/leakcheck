#!/usr/bin/env bash
# leakcheck — keep homelab names, private addresses and personal identity out of
# this PUBLIC repo.
#
#   .githooks/leakcheck --staged          what is about to be committed (pre-commit hook)
#   .githooks/leakcheck --message FILE    a commit message (commit-msg hook)
#   .githooks/leakcheck --all             every tracked file + all history metadata
#                                         (`dots doctor`, GitHub Actions)
#
# The words to block come from a denylist that lives OUTSIDE this repo, because
# the list is itself the set of names to hide:
#   $DOTFILES_DENYLIST, else ~/.config/dotfiles/denylist.txt
# Matching is case-insensitive with letter boundaries: with "oak" on the list,
# OAK_IP, oak-nas and oak2 are blocked, while "cloak" and "oaken" are not.
#
# Also blocked: private / tailnet IPs, *.ts.net, *.lan, email addresses other than
# GitHub noreply and example domains, and commits authored with any identity other
# than the one in .git-public-identity.
#
# LEAKCHECK_QUIET=1 hides the matched text (CI logs on a public repo are public).
# Bypass a single false positive deliberately with: git commit --no-verify
set -uo pipefail

mode=${1:---staged}
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "leakcheck: not in a git repo" >&2; exit 2; }
DENY=${DOTFILES_DENYLIST:-$HOME/.config/dotfiles/denylist.txt}
QUIET=${LEAKCHECK_QUIET:-0}
fail=0

# ---- denylist -> one case-insensitive ERE with letter boundaries -------------
if [ ! -r "$DENY" ]; then
    echo "leakcheck: no denylist at $DENY — refusing to check without it." >&2
    echo "           Restore it, or point DOTFILES_DENYLIST at a copy." >&2
    exit 1
fi
alts=""
while IFS= read -r w || [ -n "$w" ]; do
    w=${w%%#*}
    w="${w#"${w%%[![:space:]]*}"}"; w="${w%"${w##*[![:space:]]}"}"
    [ -n "$w" ] || continue
    w=$(printf '%s' "$w" | sed -e 's/[][\.*^$(){}?+|/]/\\&/g')
    alts=${alts:+$alts|}$w
done < "$DENY"
WORDS_RE=""
[ -n "$alts" ] && WORDS_RE="(^|[^A-Za-z])($alts)([^A-Za-z]|$)"

# ---- generic patterns (no names, safe to publish) ----------------------------
PRIV_IP_RE='(^|[^0-9.])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'
TAIL_IP_RE='(^|[^0-9.])100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'
DNS_RE='[A-Za-z0-9-]+\.(ts\.net|lan|home\.arpa)([^A-Za-z0-9-]|$)'
EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+'
EMAIL_OK_RE='(@users\.noreply\.github\.com|^noreply@github\.com$|@example\.(com|org|net|invalid)|^git@)'

report() {   # $1 where, $2 class, $3 text
    if [ "$QUIET" = 1 ]; then
        printf 'BLOCKED  %s  [%s]\n' "$1" "$2"
    else
        printf 'BLOCKED  %s  [%s]  %s\n' "$1" "$2" "$(printf '%s' "$3" | cut -c1-120)"
    fi
    fail=1
}

scan_file() {   # $1 = label, $2 = file — one grep per pattern class, not per line
    local label=$1 file=$2 hit e n
    if [ -n "$WORDS_RE" ]; then
        while IFS= read -r hit; do report "$label:${hit%%:*}" denylist "${hit#*:}"; done \
            < <(grep -niE -- "$WORDS_RE" "$file")
    fi
    while IFS= read -r hit; do report "$label:${hit%%:*}" private-ip "${hit#*:}"; done \
        < <(grep -nE -- "$PRIV_IP_RE" "$file")
    while IFS= read -r hit; do report "$label:${hit%%:*}" tailnet-ip "${hit#*:}"; done \
        < <(grep -nE -- "$TAIL_IP_RE" "$file")
    while IFS= read -r hit; do report "$label:${hit%%:*}" internal-dns "${hit#*:}"; done \
        < <(grep -niE -- "$DNS_RE" "$file")
    while IFS= read -r hit; do
        n=${hit%%:*}; e=${hit#*:}
        printf '%s\n' "$e" | grep -qiE -- "$EMAIL_OK_RE" || report "$label:$n" email "$e"
    done < <(grep -noE -- "$EMAIL_RE" "$file")
}

scan_stdin() {   # $1 = label; stdin = text
    local tmp; tmp=$(mktemp)
    cat > "$tmp"
    scan_file "$1" "$tmp"
    rm -f "$tmp"
}

public_identity() {   # prints "name<TAB>email" from .git-public-identity, if present
    local f="$root/.git-public-identity"
    [ -r "$f" ] || return 1
    printf '%s\t%s\n' "$(git config -f "$f" user.name)" "$(git config -f "$f" user.email)"
}

check_author() {   # the identity about to be used for a commit
    local want got
    want=$(public_identity) || return 0
    got=$(git var GIT_AUTHOR_IDENT | sed -E 's/^(.*) <([^>]*)>.*/\1\t\2/')
    if [ "$got" != "$want" ]; then
        echo "BLOCKED  commit author would be: $(printf '%s' "$got" | tr '\t' ' ')" >&2
        echo "         this public repo only accepts: $(printf '%s' "$want" | tr '\t' ' ')" >&2
        echo "         fix with:  dots fix   (sets the repo-local identity)" >&2
        fail=1
    fi
}

is_binary() { grep -qI . "$1" 2>/dev/null && return 1 || { [ -s "$1" ] && return 0 || return 1; }; }

case "$mode" in
    --staged)
        check_author
        while IFS= read -r -d '' f; do
            tmp=$(mktemp)
            git show ":$f" > "$tmp" 2>/dev/null
            is_binary "$tmp" || scan_file "$f" "$tmp"
            rm -f "$tmp"
        done < <(git diff --cached --name-only -z --diff-filter=ACMR)
        if command -v gitleaks >/dev/null 2>&1; then
            gitleaks git --staged --redact --no-banner "$root" >/dev/null 2>&1 \
              || gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 \
              || { echo "BLOCKED  gitleaks found a secret — run: gitleaks git --staged -v" >&2; fail=1; }
        else
            echo "leakcheck: gitleaks not installed — names and addresses checked, token formats not" >&2
        fi
        ;;
    --message)
        msgfile=${2:?usage: leakcheck --message FILE}
        scan_stdin "commit message" < <(grep -v '^#' "$msgfile")   # not a pipe: fail must survive
        ;;
    --all)
        while IFS= read -r -d '' f; do
            [ -f "$root/$f" ] || continue
            is_binary "$root/$f" || scan_file "$f" "$root/$f"
        done < <(git -C "$root" ls-files -z)
        scan_stdin "history" < <(git -C "$root" log --all --format='%an <%ae>%n%cn <%ce>%n%B' 2>/dev/null)
        if want=$(public_identity); then
            want_email=$(printf '%s' "$want" | cut -f2)
            git -C "$root" log --all --format='%ae%n%ce' 2>/dev/null | sort -u | while IFS= read -r e; do
                [ -z "$e" ] || [ "$e" = "$want_email" ] || [ "$e" = "noreply@github.com" ] \
                    || { printf 'BLOCKED  history  [identity]  %s\n' "$([ "$QUIET" = 1 ] && echo '(hidden)' || echo "$e")"; exit 3; }
            done || fail=1
        fi
        ;;
    *)
        echo "usage: leakcheck --staged | --message FILE | --all" >&2; exit 2 ;;
esac

if [ "$fail" -ne 0 ]; then
    echo "leakcheck: refused. This repo is public — move the material to the private overlay." >&2
    exit 1
fi
exit 0
