# ~/.bashrc.d/00-env.sh — generated by chezmoi (core); edit the .tmpl source.
# Environment for every shell, interactive or not. Must not print anything.
for _d in "$HOME/bin" "$HOME/.local/bin"; do
    if [ -d "$_d" ]; then
        case ":$PATH:" in *":$_d:"*) ;; *) PATH="$_d:$PATH" ;; esac
    fi
done
unset _d
export PATH
export COLORTERM=truecolor
export DOT_PROFILE={{ .profile | quote }}
export DOT_MACHINE={{ .machine | quote }}
export DOT_TMUX_AUTOATTACH={{ if .tmux_autoattach }}1{{ else }}0{{ end }}
