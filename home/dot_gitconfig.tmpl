# ~/.gitconfig — generated by chezmoi (core). Identity comes from this machine's
# init answers; per-directory identities (e.g. school) come from the include.
# The editor is $EDITOR (emacsclient via the daemon), set in ~/.bashrc.d/30-emacs.sh.
[user]
    name = {{ .git_name }}
    email = {{ .git_email }}
[init]
    defaultBranch = main
[core]
    autocrlf = input
{{- if lookPath "git-lfs" }}
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
{{- end }}
[include]
    path = ~/.config/git/local
